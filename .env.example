# =============================================================================
# GONE SURFING - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# =============================================================================

# Storage Mode: 'local' (localStorage + client canvas) | 'aws' (CloudFront + S3 + Cognito + API Gateway)
VITE_STORAGE_MODE=local

# -----------------------------------------------------------------------------
# Admin Access & Security (Local / Development)
# NOTE: Set strong credentials in your private .env file; do not commit .env
# -----------------------------------------------------------------------------
VITE_ADMIN_USER=surf_admin
VITE_ADMIN_PASSWORD=GoneSurfing#2026!SecureKey
VITE_ADMIN_SESSION_HOURS=4

# -----------------------------------------------------------------------------
# AWS Cloud Configuration (Required when VITE_STORAGE_MODE=aws)
# -----------------------------------------------------------------------------
# AWS Region
VITE_AWS_REGION=us-east-1

# REST API Gateway Endpoint (Base URL for products, orders, collections, media presign)
VITE_AWS_API_GATEWAY_URL=https://api.gonesurfing.pe/prod

# Amazon Cognito User Pool & App Client (Admin JWT Authentication)
VITE_AWS_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon S3 Bucket & CloudFront CDN (Media uploads & static assets)
VITE_AWS_S3_BUCKET=gone-surfing-media-prod
VITE_AWS_CLOUDFRONT_URL=https://media.gonesurfing.pe

# Optional 3rd Party Integrations (e.g., Email Notifications, Analytics)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

